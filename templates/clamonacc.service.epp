<%- |
  Stdlib::Absolutepath $binary_path,
  Stdlib::Absolutepath $config_path,
  String[1] $daemon_service_unit,
  Optional[Stdlib::Absolutepath] $quarantine_path = undef,
| -%>
# File managed by Puppet
[Unit]
Description=ClamAV On-Access Scanner
After=<%= $daemon_service_unit %>
Requires=<%= $daemon_service_unit %>

[Service]
Type=simple
ExecStart=<%= $binary_path %> --config-file=<%= $config_path %> --foreground<% if $quarantine_path != undef { %> --move=<%= $quarantine_path %><% } %>
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
