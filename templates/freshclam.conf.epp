<%#
  Freshclam configuration template.
  Variables expected:
    $options : Hash of option => value
%>
### File managed with puppet ###
<% if $options { -%>
<%   $option_keys = $sort_options ? {
       true    => keys($options).sort,
       default => keys($options),
     } -%>
<%   $option_keys.each |$k| { -%>
<%     $v = $options[$k] -%>
<%     $values = $v ? { Array => $v, default => [$v] } -%>
<%     $values.each |$av| { -%>
<%       if $av != undef and $av != '' { -%>
<%= $k %> <%= $av %>
<%       } -%>
<%     } -%>
<%   } -%>
<% } -%>
