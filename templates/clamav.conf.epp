<%#
  This is the main ClamAV config template.
  Variables expected:
    $config_options : Hash of option => value
    $sort_options   : Boolean to sort options alphabetically
%>
### File managed with puppet ###
<%- if $options -%>
<% $options.sort.each |$k, $v| { -%>
<% Array($v).each |$av| { -%>
<%- if $av != undef and $av != '' -%>
<%= $k %> <%= $av %>
<%- end -%>
<% } -%>
<% } -%>
<%- end -%>
