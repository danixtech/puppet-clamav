<%#
  This is the main ClamAV config template.
  Variables expected:
    $options : Hash of option => value
%>
### File managed with puppet ###

<% $option_keys = $sort_options ? {
     true    => keys($options).sort,
     default => keys($options),
   } -%>
<% $option_keys.each |$k| { -%>
<%   $v = $options[$k] -%>
<%   $values = $v =~ Array ? {
         true    => $v,
         default => [$v],
       } -%>
<%   $values.each |$av| { -%>
<%     if $av != undef and $av != '' { -%>
<%       $formatted = $av ? {
           true    => 'yes',
           false   => 'no',
           default => $av,
         } -%>
<%= $k %> <%= $formatted %>
<%     } -%>
<%   } -%>
<% } -%>
